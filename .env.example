# Application Configuration
APP_NAME=voice-rag
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sarvam AI Speech-to-Text (Saaras v3)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
DEFAULT_STT_LANGUAGE=hi-IN
STT_TIMEOUT_SECONDS=15.0

# LLM Grounded Answer Generation
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Guardrails & Grounding Constraints
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_TOKENS=2048
RELEVANCE_SCORE_THRESHOLD=0.01
GROUNDING_SCORE_THRESHOLD=0.65
ENABLE_GUARDRAILS=true
ENABLE_PROMPT_INJECTION_DEFENSE=true

# Storage & Logging
VECTOR_INDEX_PATH=./indexes
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
